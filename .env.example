# Copy to .env for local development. The SQLite file is kept out of Git.
DATABASE_URL="file:./dev.db"
# Required for Auth.js sessions. Replace with a random value in your ignored .env.
AUTH_SECRET="replace-with-a-random-secret-before-enabling-auth"
# Optional behind a reverse proxy: the public HTTPS origin.
# AUTH_URL="https://traceback.example.com"
