{
  "name": "traceback",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "DATABASE_URL=file:./session2-test.db node --import tsx scripts/migrate.ts && DATABASE_URL=file:./session2-test.db vitest run",
    "e2e": "playwright test",
    "build": "next build --webpack",
    "migrate": "node --import tsx scripts/migrate.ts",
    "seed": "node --import tsx prisma/seed.ts",
    "perf:check": "node --import tsx scripts/perf-check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/generate-prisma.mjs"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.2",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pdfkit": "0.17.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "recharts": "3.2.1",
    "rehype-sanitize": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.3.0",
    "@types/pdfkit": "0.17.3",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.23",
    "prettier": "3.6.2",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
