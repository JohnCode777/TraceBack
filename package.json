{
  "name": "traceback",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "DATABASE_URL=file:./session2-test.db node --import tsx scripts/migrate.ts && DATABASE_URL=file:./session2-test.db vitest run",
    "e2e": "playwright test",
    "build": "next build",
    "migrate": "node --import tsx scripts/migrate.ts",
    "seed": "node --import tsx prisma/seed.ts",
    "pdf:spike": "node --import tsx scripts/pdf-spike.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/generate-prisma.mjs"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "@prisma/adapter-libsql": "6.16.2",
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.30",
    "pdfkit": "0.17.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "@types/pdfkit": "0.17.3",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "6.16.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
